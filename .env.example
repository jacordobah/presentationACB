# Host ports published by the web container.
HTTPS_PORT=8443
HTTP_PORT=8088

# Build-time settings of the app. `npm run dev` reads them too.
VITE_LOCATION_SIMULATOR=true
VITE_POSITION_INTERVAL_MS=5000
VITE_POLL_INTERVAL_MS=5000

# Upstreams that Nginx proxies /api/admin and /api/geo to. They default to admin-api and
# geoloca-api on acb-net.
# ADMIN_API_URL=http://admin-api:8080
# GEO_API_URL=http://geoloca-api:8000
