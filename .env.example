# Host ports published by the web container.
HTTPS_PORT=8443
HTTP_PORT=8088

# Build-time settings of the app. `npm run dev` reads them too.
VITE_LOCATION_SIMULATOR=true
VITE_POLL_INTERVAL_MS=5000

# Upstreams that Nginx proxies /api/admin and /api/geo to. Both point at the
# API gateway, the only entry point: it forwards /api/v1/admin/* to adminACB
# and /api/v1/* to geolocaACB, and /api/v1/tracking-sessions/* to the Go GPS.
ADMIN_API_URL=http://api-gateway:5062
GEO_API_URL=http://api-gateway:5062
