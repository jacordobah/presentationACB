# Host ports published by the web container.
HTTPS_PORT=8443
HTTP_PORT=8088

# Build-time settings of the app. `npm run dev` reads them too.
VITE_LOCATION_SIMULATOR=true
VITE_POLL_INTERVAL_MS=5000

# GPS tracking is enabled for the local test stack. The gateway still
# overrides the policy with its own GPS_POLICY_ID.
VITE_GPS_TRACKING_ENABLED=true
# Reference value; gatewayACB is authoritative for the policy.
VITE_GPS_POLICY_ID=acb-local-v1
VITE_TRACKING_INTERVAL_MS=5000
# Used only for the ETA shown to the guide; it is an estimate, not a schedule.
VITE_ESTIMATED_SPEED_KMH=10
# Optional link for non-guide users on the login screen.
# VITE_ADMIN_APP_URL=http://localhost:8080

# Upstreams that Nginx proxies /api/admin and /api/geo to. Both point at the
# API gateway, the only entry point: it forwards /api/v1/admin/* to adminACB
# and /api/v1/* to geolocaACB, and /api/v1/tracking-sessions/* to the Go GPS.
ADMIN_API_URL=http://api-gateway:5062
GEO_API_URL=http://api-gateway:5062
