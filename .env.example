# Host ports published by the web container.
HTTPS_PORT=8443
HTTP_PORT=8088

# Build-time settings of the app. `npm run dev` reads them too.
VITE_LOCATION_SIMULATOR=true
VITE_POLL_INTERVAL_MS=5000

# Upstreams that Nginx proxies /api/admin and /api/geo to. The gateway joins acb-net as
# api-gateway and forwards /api/v1/auth and the admin_users endpoints to adminACB.
ADMIN_API_URL=http://api-gateway:5062
GEO_API_URL=http://geoloca-api:8000
